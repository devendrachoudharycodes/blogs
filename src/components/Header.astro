</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0;
		background: rgba(255, 255, 255, 0.95);
		border-bottom: 1px solid rgba(var(--black), 10%);
		backdrop-filter: blur(12px);
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.25rem;
		min-height: 72px;

		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	/* Brand */

	.brand {
		flex-shrink: 0;
	}

	.brand-link {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		padding: 0 !important;

		color: var(--black);
		text-decoration: none;
		border: none !important;
	}

	.brand-name {
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}

	.brand-subtitle {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--accent);
	}

	/* Main Navigation */

	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.15rem;
		flex: 1;
	}

	.internal-links a {
		padding: 1.4rem 0.75rem;
		color: var(--black);
		text-decoration: none;
		border-bottom: 3px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.internal-links a:hover {
		color: var(--accent);
	}

	.internal-links a.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	/* Social Links */

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex-shrink: 0;
	}

	.social-links a {
		width: 38px;
		height: 38px;

		display: flex;
		align-items: center;
		justify-content: center;

		color: var(--black);
		border-radius: 8px;
		text-decoration: none;

		transition:
			color 0.2s ease,
			background-color 0.2s ease,
			transform 0.2s ease;
	}

	.social-links a:hover {
		color: var(--accent);
		background: rgba(var(--black), 5%);
		transform: translateY(-1px);
	}

	.social-links svg {
		width: 20px;
		height: 20px;
	}

	/* Accessibility */

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Tablet */

	@media (max-width: 900px) {
		.nav-container {
			gap: 1rem;
		}

		.internal-links a {
			padding-left: 0.5rem;
			padding-right: 0.5rem;
		}

		.brand-name {
			font-size: 1rem;
		}
	}

	/* Mobile */

	@media (max-width: 720px) {
		.nav-container {
			min-height: 64px;
			padding: 0 1rem;
		}

		.brand-subtitle {
			display: none;
		}

		.internal-links {
			gap: 0;
		}

		.internal-links a {
			padding: 1.25rem 0.4rem;
			font-size: 0.85rem;
		}

		.social-links {
			display: none;
		}
	}

	@media (max-width: 500px) {
		.brand-name {
			font-size: 0.95rem;
		}

		.internal-links a {
			padding-left: 0.3rem;
			padding-right: 0.3rem;
			font-size: 0.78rem;
		}

		.internal-links a:nth-child(3),
		.internal-links a:nth-child(4) {
			display: none;
		}
	}
</style>
