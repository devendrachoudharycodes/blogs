---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />

		<style>
			main {
				width: 100%;
				margin: 0;
			}

			/* ================================
			   Article Header
			================================ */

			.article-header {
				max-width: 900px;
				margin: 0 auto;
				padding: 5rem 1.25rem 3rem;
			}

			.breadcrumbs {
				margin-bottom: 2rem;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}

			.breadcrumbs a {
				color: rgb(var(--gray));
				text-decoration: none;
			}

			.breadcrumbs a:hover {
				color: var(--accent);
			}

			.article-header h1 {
				max-width: 850px;
				margin: 0;
				font-size: clamp(2.5rem, 6vw, 4.5rem);
				line-height: 1.05;
				letter-spacing: -0.045em;
			}

			.description {
				max-width: 750px;
				margin: 1.5rem 0 0;
				font-size: 1.2rem;
				line-height: 1.7;
				color: rgb(var(--gray-dark));
			}

			.article-meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 2rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}

			.meta-separator {
				opacity: 0.5;
			}

			.last-updated {
				font-style: italic;
			}

			/* ================================
			   Hero Image
			================================ */

			.hero-image-wrapper {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 1.25rem 4rem;
			}

			.hero-image {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 14px;
				box-shadow: var(--box-shadow);
			}

			/* ================================
			   Article
			================================ */

			.article-container {
				width: 100%;
			}

			.prose {
				width: 720px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding-bottom: 5rem;

				color: rgb(var(--gray-dark));

				font-size: 1.08rem;
				line-height: 1.8;
			}

			/* ================================
			   Typography
			================================ */

			.prose :global(h2) {
				margin-top: 3.5rem;
				margin-bottom: 1rem;

				font-size: 2rem;
				line-height: 1.2;
				letter-spacing: -0.03em;
				color: rgb(var(--black));
			}

			.prose :global(h3) {
				margin-top: 2.5rem;
				margin-bottom: 0.75rem;

				font-size: 1.5rem;
				line-height: 1.3;
				color: rgb(var(--black));
			}

			.prose :global(h4) {
				margin-top: 2rem;
				margin-bottom: 0.5rem;

				font-size: 1.2rem;
				color: rgb(var(--black));
			}

			.prose :global(p) {
				margin: 1.25rem 0;
			}

			.prose :global(a) {
				color: var(--accent);
				font-weight: 500;
			}

			.prose :global(strong) {
				color: rgb(var(--black));
				font-weight: 700;
			}

			.prose :global(em) {
				font-style: italic;
			}

			/* ================================
			   Lists
			================================ */

			.prose :global(ul),
			.prose :global(ol) {
				margin: 1.5rem 0;
				padding-left: 1.5rem;
			}

			.prose :global(li) {
				margin: 0.5rem 0;
				padding-left: 0.25rem;
			}

			/* ================================
			   Blockquotes
			================================ */

			.prose :global(blockquote) {
				margin: 2rem 0;
				padding: 1rem 1.5rem;

				border-left: 4px solid var(--accent);

				background: rgba(var(--black), 4%);

				font-style: italic;
			}

			.prose :global(blockquote p) {
				margin: 0;
			}

			/* ================================
			   Inline Code
			================================ */

			.prose :global(:not(pre) > code) {
				padding: 0.15em 0.4em;

				border-radius: 5px;

				background: rgba(var(--black), 7%);

				font-size: 0.9em;
				font-family:
					'JetBrains Mono',
					'Fira Code',
					monospace;

				color: rgb(var(--black));
			}

			/* ================================
			   Code Blocks
			================================ */

			.prose :global(pre) {
				margin: 2rem -2rem;
				padding: 1.5rem;

				overflow-x: auto;

				border-radius: 10px;

				font-size: 0.9rem;
				line-height: 1.6;
			}

			/* ================================
			   Tables
			================================ */

			.prose :global(table) {
				width: 100%;
				margin: 2rem 0;

				border-collapse: collapse;

				font-size: 0.95rem;
			}

			.prose :global(th),
			.prose :global(td) {
				padding: 0.75rem;
				border: 1px solid rgba(var(--black), 15%);
				text-align: left;
			}

			.prose :global(th) {
				background: rgba(var(--black), 5%);
				color: rgb(var(--black));
				font-weight: 700;
			}

			/* ================================
			   Images inside articles
			================================ */

			.prose :global(img) {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 2rem auto;
				border-radius: 10px;
			}

			.prose :global(figure) {
				margin: 2rem 0;
			}

			.prose :global(figcaption) {
				margin-top: -1rem;
				text-align: center;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}

			/* ================================
			   Horizontal Rule
			================================ */

			.prose :global(hr) {
				margin: 3rem 0;
				border: 0;
				border-top: 1px solid rgba(var(--black), 12%);
			}

			/* ================================
			   Article Footer
			================================ */

			.article-end {
				width: 720px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 2rem 0 5rem;
				border-top: 1px solid rgba(var(--black), 12%);
			}

			.author-card {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.author-avatar {
				width: 52px;
				height: 52px;

				display: flex;
				align-items: center;
				justify-content: center;

				border-radius: 50%;

				background: var(--accent);
				color: white;

				font-weight: 700;
				font-size: 1rem;
			}

			.author-info {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			.author-name {
				font-weight: 700;
				color: rgb(var(--black));
			}

			.author-description {
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}

			/* ================================
			   Responsive
			================================ */

			@media (max-width: 720px) {
				.article-header {
					padding-top: 3.5rem;
					padding-bottom: 2.5rem;
				}

				.article-header h1 {
					font-size: clamp(2.3rem, 11vw, 3.5rem);
				}

				.description {
					font-size: 1.05rem;
				}

				.hero-image-wrapper {
					padding-bottom: 3rem;
				}

				.prose {
					font-size: 1rem;
					line-height: 1.75;
				}

				.prose :global(h2) {
					font-size: 1.7rem;
					margin-top: 3rem;
				}

				.prose :global(h3) {
					font-size: 1.35rem;
				}

				.prose :global(pre) {
					margin-left: -0.5rem;
					margin-right: -0.5rem;
					border-radius: 8px;
				}

				.article-meta {
					gap: 0.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<!-- Article Header -->
			<header class="article-header">

				<nav class="breadcrumbs" aria-label="Breadcrumb">
					<a href="/">Home</a>
					<span> / </span>
					<a href="/blog">Blog</a>
					<span> / </span>
					<span>{title}</span>
				</nav>

				<h1>{title}</h1>

				<p class="description">
					{description}
				</p>

				<div class="article-meta">
					<span>
						Published <FormattedDate date={pubDate} />
					</span>

					{
						updatedDate && (
							<>
								<span class="meta-separator">•</span>

								<span class="last-updated">
									Updated <FormattedDate date={updatedDate} />
								</span>
							</>
						)
					}

					<span class="meta-separator">•</span>

					<span>Devendra Choudhary</span>
				</div>

			</header>

			<!-- Hero Image -->
			{
				heroImage && (
					<div class="hero-image-wrapper">
						<Image
							class="hero-image"
							width={1100}
							height={550}
							src={heroImage}
							alt={title}
						/>
					</div>
				)
			}

			<!-- Article Content -->
			<article class="article-container">
				<div class="prose">
					<slot />
				</div>
			</article>

			<!-- Author -->
			<section class="article-end">
				<div class="author-card">

					<div class="author-avatar" aria-hidden="true">
						DC
					</div>

					<div class="author-info">
						<span class="author-name">
							Devendra Choudhary
						</span>

						<span class="author-description">
							Writing about Java, Spring Boot, Android,
							Kotlin, and software engineering.
						</span>
					</div>

				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
